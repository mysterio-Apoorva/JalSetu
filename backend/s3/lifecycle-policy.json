{
  "Rules": [
    {
      "ID": "JalSetu-Glacier-Retention-Rule",
      "Filter": {
        "Prefix": "proofs/"
      },
      "Status": "Enabled",
      "Transitions": [
        {
          "Days": 90,
          "StorageClass": "GLACIER"
        },
        {
          "Days": 365,
          "StorageClass": "DEEP_ARCHIVE"
        }
      ],
      "Expiration": {
        "Days": 2555
      }
    }
  ]
}
